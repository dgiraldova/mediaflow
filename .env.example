# Copy this file to .env for a local demo.
MEDIAFLOW_DATABASE_URL=sqlite:///./mediaflow-demo.db
MEDIAFLOW_INTERNAL_WORKER_TOKEN=change-me-before-sharing
MEDIAFLOW_JWT_SECRET=replace-with-a-long-random-local-secret
# Base URL of Team C's local proxy server or the production media CDN.
MEDIAFLOW_MEDIA_BASE_URL=http://127.0.0.1:8001
