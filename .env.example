# Copy this file to .env for a local demo.
MEDIAFLOW_DATABASE_URL=sqlite:///./mediaflow-demo.db
MEDIAFLOW_INTERNAL_WORKER_TOKEN=change-me-before-sharing
MEDIAFLOW_JWT_SECRET=replace-with-a-long-random-local-secret

# Originals, generated proxies, and thumbnails stay here in local mode.
MEDIAFLOW_MEDIA_STORAGE_PATH=./var/media
MEDIAFLOW_MEDIA_BASE_URL=http://127.0.0.1:3000/api/v1/media
MEDIAFLOW_MAX_UPLOAD_BYTES=10737418240

# The worker and API must share the same storage directory and internal token.
WORKER_STORAGE_BACKEND=local
WORKER_LOCAL_STORAGE_PATH=./var/media
WORKER_LOCAL_MEDIA_BASE_URL=http://127.0.0.1:3000/api/v1/media
MEDIAFLOW_API_BASE_URL=http://127.0.0.1:3000
MEDIAFLOW_API_INTERNAL_TOKEN=change-me-before-sharing

# Optional AI providers. OPENAI_API_KEY is also used for transcription when
# TRANSCRIPTION_API_KEY is blank, so one OpenAI key is enough for local use.
TRANSCRIPTION_API_KEY=
OPENAI_API_KEY=
TWELVE_LABS_API_KEY=

# Cloudflare R2 is intentionally disabled for now. Set WORKER_STORAGE_BACKEND=r2
# and fill these later when the project is ready to move off local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mediaflow-media
